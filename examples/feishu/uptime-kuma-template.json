{
  "schema": "2.0",
  "config": {
    "width_mode": "compact",
    "enable_forward": true,
    "summary": {
      "content": "[{{event.statusDisplay}}] {{payload.monitor.name}} · {{event.message}}"
    }
  },
  "header": {
    "template": "{{bindings.statusColor}}",
    "title": {
      "tag": "plain_text",
      "content": "{{payload.monitor.name}}"
    },
    "subtitle": {
      "tag": "plain_text",
      "content": "Uptime Kuma · {{event.occurredAtDisplay}}"
    },
    "text_tag_list": [
      {
        "tag": "text_tag",
        "text": {
          "tag": "plain_text",
          "content": "{{event.statusDisplay}}"
        },
        "color": "{{bindings.statusColor}}"
      },
      {
        "tag": "text_tag",
        "text": {
          "tag": "plain_text",
          "content": "{{payload.monitor.type}}"
        },
        "color": "blue"
      }
    ]
  },
  "body": {
    "direction": "vertical",
    "padding": "12px 12px 10px 12px",
    "vertical_spacing": "8px",
    "elements": [
      {
        "tag": "markdown",
        "content": "**{{presentation.labels.checkResult}}**\n{{event.message}}",
        "text_size": "normal"
      },
      {
        "tag": "column_set",
        "flex_mode": "bisect",
        "background_style": "grey",
        "columns": [
          {
            "tag": "column",
            "width": "weighted",
            "weight": 1,
            "vertical_spacing": "4px",
            "elements": [
              {
                "tag": "div",
                "text": {
                  "tag": "lark_md",
                  "content": "**{{presentation.labels.status}}**\n{{event.statusDisplay}}",
                  "text_size": "notation"
                }
              },
              {
                "tag": "div",
                "text": {
                  "tag": "lark_md",
                  "content": "**{{presentation.labels.responseTime}}**\n{{payload.heartbeat.ping}} ms",
                  "text_size": "notation"
                }
              }
            ]
          },
          {
            "tag": "column",
            "width": "weighted",
            "weight": 1,
            "vertical_spacing": "4px",
            "elements": [
              {
                "tag": "div",
                "text": {
                  "tag": "lark_md",
                  "content": "**{{presentation.labels.checkType}}**\n{{payload.monitor.type}}",
                  "text_size": "notation"
                }
              },
              {
                "tag": "div",
                "text": {
                  "tag": "lark_md",
                  "content": "**{{presentation.labels.monitorId}}**\n{{payload.monitor.id}}",
                  "text_size": "notation"
                }
              }
            ]
          }
        ]
      },
      {
        "tag": "markdown",
        "content": "**{{presentation.labels.monitorPath}}**\n{{payload.monitor.pathName}}",
        "text_size": "notation"
      },
      {
        "tag": "markdown",
        "content": "**{{presentation.labels.checkUrl}}**\n`{{payload.monitor.url}}`",
        "text_size": "notation"
      },
      {
        "tag": "markdown",
        "content": "**{{presentation.labels.lastFailure}}**\n{{payload.heartbeat.lastDownTime}}",
        "text_size": "notation"
      },
      {
        "tag": "hr"
      },
      {
        "tag": "markdown",
        "content": "{{presentation.labels.source}}: {{source.name}}  ·  {{presentation.labels.eventId}}: `{{event.id}}`\n{{presentation.labels.fingerprint}}: `{{event.fingerprint}}`",
        "text_size": "notation"
      }
    ]
  }
}
