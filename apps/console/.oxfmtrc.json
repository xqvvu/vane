{
  "$schema": "../../node_modules/oxfmt/configuration_schema.json",

  "ignorePatterns": ["src/route-tree.gen.ts"],

  "sortTailwindcss": true,
  "sortImports": {
    "customGroups": [
      {
        "groupName": "vane",
        "elementNamePattern": ["@vane/**"]
      }
    ],
    "groups": [
      "builtin",
      "external",
      "vane",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ],
    "internalPattern": ["~~/", "~/", "#/", "@/"]
  }
}
