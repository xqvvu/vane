{
  "name": "@vane/destinations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./email": "./src/email/index.ts",
    "./feishu": "./src/feishu/index.ts",
    "./feishu/appearance": "./src/feishu/appearance.ts",
    "./feishu/card-types": "./src/feishu/card.types.ts",
    "./feishu/default-card": "./src/feishu/default-card.ts",
